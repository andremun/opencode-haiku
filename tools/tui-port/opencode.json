{
  "model": "local/haiku-qwen17",
  "update": "disable",
  "share": "disabled",
  "snapshots": false,
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "providers": {
    "local": {
      "name": "Native Haiku CPU",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:18081/v1",
        "apiKey": "",
        "provider": "local",
        "headerTimeout": 1800000,
        "timeout": 1800000,
        "chunkTimeout": 900000
      },
      "models": {
        "haiku-qwen17": {
          "name": "Qwen3 1.7B CPU",
          "capabilities": {
            "tools": false,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 4096,
            "output": 64
          },
          "body": {
            "temperature": 0,
            "max_tokens": 64,
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "local/haiku-qwen17",
      "steps": 4
    },
    "title": {
      "model": "local/haiku-qwen17",
      "steps": 4
    },
    "summary": {
      "model": "local/haiku-qwen17",
      "steps": 4
    },
    "probe": {
      "mode": "primary",
      "model": "local/haiku-qwen17",
      "system": "You are a concise assistant. Follow the user request. No tools are available.",
      "steps": 4
    }
  },
  "default_agent": "probe"
}
