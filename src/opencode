set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export OPENCODE_PTY_BIN="$root/opencode-pty"
export OPENCODE_NODE_PTY_PATH="$root/node-pty"
export OPENCODE_HAIKU_CLIPBOARD="$root/haiku-clipboard.cjs"
export OPENCODE_HAIKU_KOFFI="$root/koffi"
export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require=$root/haiku-loader.cjs"
export LIBRARY_PATH="$root/lib:/boot/system/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
exec node "$root/opencode.mjs" "$@"
