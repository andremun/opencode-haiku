({\n    group,\n    total: Math.round(total * 100) / 100,\n    count,\n  }));\n\n  result.sort((a, b) => a.group.localeCompare(b.group));\n\n  return result;\n}","oldString":"import { parseCSV } from './csv.mjs';\n\n// summarize(csvText, { groupBy, sum }) -> [{ group, total, count }]\n// See test/report.test.mjs for the required behaviour.\nexport function summarize(csvText, options) {\n  throw new Error('not implemented');\n}","path":"/boot/home/cloud-20261021/opencode_nemotron-3.5-lightning-free/cloud-1792547817492/fixture/src/report.mjs"},"output":"Edited src/report.mjs (1 replacement)","title":"edit","metadata":{"metadata":{"files":[{"file":"src/report.mjs","patch":"Index: src/report.mjs\n===================================================================\n--- src/report.mjs\n+++ src/report.mjs\n@@ -1,7 +1,65 @@\n import { parseCSV } from './csv.mjs';\n \n // summarize(csvText, { groupBy, sum }) -> [{ group, total, count }]\n-// See test/report.test.mjs for the required behaviour.\n+// Groups rows by groupBy column, sums the sum column, counts rows per group.\n+// Raises Error /unknown column: X/ if column not found.\n+// Raises Error /not a number/ if sum value is non-numeric.\n export function summarize(csvText, options) {\n-  throw new Error('not implemented');\n+  const rows = parseCSV(csvText);\n+\n+  if (rows.length === 0) return [];\n+\n+  const header = rows[0];\n+\n+  // Find column indices\n+  const groupByIdx = header.indexOf(options.groupBy);\n+  const sumIdx = header.indexOf(options.sum);\n+\n+  if (groupByIdx === -1) {\n+    throw new Error(`unknown column: ${options.groupBy}`);\n+  }\n+  if (sumIdx === -1) {\n+    throw new Error(`unknown column: ${options.sum}`);\n+  }\n+\n+  // Group and sum\n+  const groups = {};\n+\n+  for (let i = 1; i < rows.length; i++) {\n+    const row = rows[i];\n+\n+    // Skip blank rows (all empty fields)\n+    if (row.length === 0) continue;\n+    let hasContent = false;\n+    for (const field of row) {\n+      if (f