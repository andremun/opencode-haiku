,abc\\n', { groupBy: 'k', sum: 'v' }), /not a number/i);\n30: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file test/report.test.mjs, lines 1-30\n1: import test from 'node:test';\n2: import assert from 'node:assert/strict';\n3: import { summarize } from '../src/report.mjs';\n4: \n5: const data = 'category,amount,note\\nfood,10.50,\"lunch, big\"\\nrent,1000,\\nfood,4.25,snack\\nfun,20,\\nrent,50.5,late fee\\n';\n6: \n7: test('groups, sums and counts, sorted by group name', () => {\n8:   assert.deepEqual(summarize(data, { groupBy: 'category', sum: 'amount' }), [\n9:     { group: 'food', total: 14.75, count: 2 },\n10:     { group: 'fun', total: 20, count: 1 },\n11:     { group: 'rent', total: 1050.5, count: 2 },\n12:   ]);\n13: });\n14: test('totals are rounded to two decimals', () => {\n15:   const rows = 'k,v\\na,0.1\\na,0.2\\n';\n16:   assert.deepEqual(summarize(rows, { groupBy: 'k', sum: 'v' }), [{ group: 'a', total: 0.3, count: 2 }]);\n17: });\n18: test('blank lines are ignored', () => {\n19:   assert.deepEqual(summarize('k,v\\n\\na,1\\n\\n', { groupBy: 'k', sum: 'v' }), [{ group: 'a', total: 1, count: 1 }]);\n20: });\n21: test('quoted group names are supported', () => {\n22:   assert.deepEqual(summarize('k,v\\n\"x, y\",2\\n\"x, y\",3\\n', { groupBy: 'k', sum: 'v' }), [{ group: 'x, y', total: 5, count: 2 }]);\n23: });\n24: test('unknown column throws a helpful error', () => {\n25:   assert.throws(() => summarize(data, { groupBy: 'nope', sum: 'amount' }), /unknown column: nope/);\n26:   assert.throws(() => summarize(data, { groupBy: 'category', sum: 'missing' }), /unknown column: missing/);\n27: });\n28: test('non-numeric amount throws', () => {\n29:   assert.throws(() => summarize('k,v\\na,abc\\n', { groupBy: 'k', sum: 'v' }), /not a number/i);\n30: });"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"test/report.test.mjs\"}"},"time":{"start":1792548727232,"end