{"type":"tool_use","timestamp":1792245068857,"sessionID":"ses_eb5df1f9affeg1Ae1pGYW4GvBf","part":{"partID":"prt_14a217428001jfmecL9uTLEga3","sessionID":"ses_eb5df1f9affeg1Ae1pGYW4GvBf","messageID":"msg_14a213b6f00136Ddb287fkFiWe","type":"tool","id":"56c256e4-0441-470d-8458-4c5c74552733","tool":"write","state":{"status":"completed","input":{"content":"import { parseCSV } from './csv.mjs';\n\n// summarize(csvText, { groupBy, sum }) -> [{ group, total, count }]\n// Groups rows by a column, sums a numeric column and counts rows per group.\n// Results are sorted by group name; totals are rounded to two decimals.\nexport function summarize(csvText, options = {}) {\n  const { groupBy, sum } = options;\n\n  if (groupBy === undefined) {\n    throw new Error('unknown column: undefined (provide options.groupBy)');\n  }\n  if (sum === undefined) {\n    throw new Error('unknown column: undefined (provide options.sum)');\n  }\n\n  const rows = parseCSV(csvText);\n  if (rows.length === 0) return [];\n\n  const headers = rows[0];\n\n  const checkColumn = (column) => {\n    if (!headers.includes(column)) {\n      throw new Error(`unknown column: ${column}`);\n    }\n  };\n  checkColumn(groupBy);\n  checkColumn(sum);\n\n  const groupIndex = headers.indexOf(groupBy);\n  const sumIndex = headers.indexOf(sum);\n\n  const totals = new Map();\n\n  for (const row of rows.slice(1)) {\n    // Skip blank rows that only contain empty fields.\n    if (row.every((cell) => cell === '')) continue;\n\n    const key = row[groupIndex] ?? '';\n    const raw = row[sumIndex] ?? '';\n    const value = Number(raw);\n    if (!Number.isFinite(value)) {\n      throw new Error(`not a number: \"${raw}\" in column \"${sum}\"`);\n    }\n\n    const entry = totals.get(key) ?? { total: 0, count: 0 };\n    entry.total += value;\n    entry.count += 1;\n    totals.set(key, entry);\n  }\n\n  return Array.from(totals.entries())\n    .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))\n    .map(([group, { total, count }])