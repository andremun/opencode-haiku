diff --git a/common/reasoning-budget.cpp b/common/reasoning-budget.cpp
index cc408a686..6cd55ab06 100644
--- a/common/reasoning-budget.cpp
+++ b/common/reasoning-budget.cpp
@@ -122,6 +122,20 @@ static void common_reasoning_budget_accept(struct llama_sampler * smpl, llama_to
             }
             break;
         case REASONING_BUDGET_DONE:
+            // The sampler is also fed the prompt. A conversation with tool
+            // calls has finished thinking blocks of earlier assistant turns
+            // in it, and without this the budget would be spent before the
+            // reply starts. Arm it again at every new start tag.
+            if (ctx->start_matcher.advance(token)) {
+                ctx->state = REASONING_BUDGET_COUNTING;
+                ctx->remaining = ctx->budget;
+                ctx->end_matcher.reset();
+                LOG_INF("reasoning-budget: activated again, budget=%d tokens\n", ctx->budget);
+                if (ctx->remaining <= 0) {
+                    ctx->state = REASONING_BUDGET_FORCING;
+                    ctx->force_pos = 0;
+                }
+            }
             break;
     }
 }
